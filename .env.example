# Kopieren Sie diese Datei zu .env und passen Sie die Werte an

# Server-Port (Standard: 3000)
PORT=3000

# Sitzungsgeheimnis – unbedingt mit einem langen Zufallswert ersetzen!
# Generieren: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=BITTE_AENDERN_langer_zufaelliger_wert

# Umgebung: development oder production
NODE_ENV=development

# Admin-Benutzername (Standard: admin)
ADMIN_USERNAME=admin

# Kontakt-E-Mail (für Mitgliedsantrag-Benachrichtigungen, optional)
# CONTACT_EMAIL=vorstand@sv-fortuna-griefstedt.de
